---
/*
 * Inline SVG rather than an icon font or a sprite request: these are a few
 * hundred bytes each, they inherit `currentColor` so they work in both themes
 * without a second set, and they cost no network round-trip on a page someone
 * may be loading on a phone with one bar.
 *
 * Icons are decorative here -- every one sits beside a text label -- so they
 * are hidden from screen readers unless a `title` is passed.
 */
interface Props {
  name: keyof typeof PATHS;
  size?: number;
  title?: string;
  class?: string;
}
const { name, size = 20, title, class: klass } = Astro.props;

const PATHS = {

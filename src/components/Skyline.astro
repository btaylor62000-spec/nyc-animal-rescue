---
/*
 * The New York skyline as a single continuous line.
 *
 * Drawn rather than photographed or licensed: about 2KB of markup, no network
 * request, sharp at any size, and it takes its colour from `currentColor` so
 * dark mode needs no second asset.
 *
 * It really is one unbroken stroke -- the whole thing is a single `d`, running
 * left to right: an opening ripple, the Statue of Liberty, lower Manhattan
 * with One World Trade Center's tapered tower and spire, midtown with the
 * Chrysler Building's crown, the Empire State Building's setbacks and mast
 * and 432 Park's thin slab, then the Brooklyn Bridge (its two towers with
 * their pointed double arches, the deck, and the cables), and a trailing
 * ripple. Redrawn 2026-11-06: a reviewer said the generic stepped skyline
 * did not read as New York. Spires double back on themselves, which is what a one-line drawing
 * does and why they read as single strokes rather than loops.
 *
 * This style was chosen over a filled silhouette or detailed line art because
 * the band is shallow. Fine interior detail -- window grids, floor lines --
 * collapses into mush at 40-130px tall, whereas one clean contour survives.
 *
 * `vector-effect: non-scaling-stroke` fixes the line weight in screen pixels.
 * Without it the stroke would scale with the drawing and thin away to nothing
 * in exactly the shallow band this is built for.
 *
 * Decorative, so it is hidden from screen readers.
 */
interface Props { class?: string }
const { class: klass } = Astro.props;
---
<svg
  class={klass}
  viewBox="0 0 1800 180"
  preserveAspectRatio="xMidYMax meet"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <path
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linejoin="round"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"
    d="M0 160

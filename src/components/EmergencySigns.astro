---
/*
 * What to do when an animal needs help now, in a few short sentences a
 * 12-year-old can follow.
 *
 * Rewritten from scratch by the owner's decision on 2026-11-15, twice: first
 * the reviewer's single 60-word sentence, then a bulleted list of signs that
 * was still too much to take in. This version leads with the action, not a
 * list of symptoms: someone looking at a hurt animal already knows it is hurt.
 * One sentence per idea, nothing in brackets, no dashes, no jargon
 * ("rehabilitator"). The bitten-or-caught line stays in bold, because it is
 * the warning people get wrong (rule 4 in CLAUDE.md).
 *
 * Used in three places so they cannot drift apart: the red band on the home
 * page, the warning on emergency guides, and the assistant page.
 *
 * `compact` (owner, 2026-11-15: "is there any way to compress this?") is the
 * same advice in two lines for guide pages and the assistant page, where the
 * card below already says what to do. The bitten-or-caught warning stays,
 * in bold, in both.
 */
interface Props {
  /** Where the reader finds help for a wild animal: the list below, or links. */
  wild?: 'below' | 'links';
  compact?: boolean;
}
const { wild = 'links', compact = false } = Astro.props;
---
{compact ? (
<p class="esigns esigns--compact">
  <strong>Badly hurt or very sick?</strong> Go to an emergency vet now; if you can, call while you travel.
  <strong>Bitten or caught by another animal? Go now, even if you can’t see a wound.</strong>{' '}
  <a href="/directory?need=emergency-vet&near=1">Emergency vets open now&nbsp;&rarr;</a>
</p>
) : (
<div class="esigns">
  <p class="esigns__lead">Is an animal badly hurt or very sick?</p>
  <p>Take it to an emergency vet now. Don’t wait on the phone: if you can, call while you travel so they can get ready.</p>
  <p><strong>If another animal bit it or caught it, go now, even if you can’t see a wound.</strong></p>
  <p>Not sure? Call an emergency vet and ask.</p>
  {wild === 'below'
    ? <p>Found a hurt wild animal or bird? Pick it from the list below.</p>
    : <p>Found a hurt wild animal or bird? <a href="/guides/found-an-injured-bird">Birds</a> · <a href="/guides/found-wildlife">Other wild animals</a></p>}
</div>
)}

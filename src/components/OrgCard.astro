---
import type { Org } from '../types.ts';
import { ANIMAL_LABELS, BOROUGH_LABELS, NEED_LABELS, STATUS_LABELS, daysSinceVerified, isNewlyFound, needsConfirmation } from '../data/orgs.ts';
import ConfidenceBadge from './ConfidenceBadge.astro';
import Icon from './Icon.astro';

interface Props { org: Org }
const { org } = Astro.props;

const age = daysSinceVerified(org);
const confirm = needsConfirmation(org);
const newlyFound = isNewlyFound(org);

const where = org.citywide
  ? 'All five boroughs'
  : org.boroughs.length
    ? org.boroughs.map((b) => BOROUGH_LABELS[b]).join(', ')
    : org.outside_nyc
      ? 'Outside NYC, serves New Yorkers'
      : 'Area not recorded';

// A card shows what someone needs to decide whether to tap: what it is, where
// it works, and how fresh the information is. Everything else is on the page.
const topNeeds = org.needs.slice(0, 4);
const phone = org.phones[0];
---
<li
  class="card"
  data-org-id={org.id}
  data-name={org.name}
  data-animals={org.animals.join(',')}
  data-needs={org.needs.join(',')}
  data-boroughs={org.boroughs.join(',')}
  data-zips={org.zips.join(',')}
  data-citywide={org.citywide ? '1' : '0'}
  data-confidence={org.confidence}
  data-status={org.status}
  data-has-phone={org.phones.length ? '1' : '0'}
  data-verified={org.last_verified ?? ''}
>
  <h3 class="card__title"><a href={`/org/${org.id}`}>{org.name}</a></h3>

  <p class="card__meta">
    <Icon name="pin" size={15} />
    {where}
    {org.animals.length > 0 && <> · {org.animals.slice(0, 3).map((a) => ANIMAL_LABELS[a]).join(', ')}</>}
  </p>

  <ul class="card__tags">
    <li><ConfidenceBadge confidence={org.confidence} /></li>
    {newlyFound && <li><span class="tag tag--strong">Newly found — not yet verified</span></li>}
    {org.status !== 'active' && <li><span class="tag tag--strong">{STATUS_LABELS[org.status]}</span></li>}
    {topNeeds.map((n) => <li><span class="tag">{NEED_LABELS[n]}</span></li>)}
  </ul>

  {(phone || org.website) && (
    <div class="card__actions">
      {phone && (
        <a class="btn btn--primary" href={`tel:+1${phone.value}`}>
          <Icon name="phone" size={17} />
          Call {phone.display}
        </a>
      )}
      <a class="btn" href={`/org/${org.id}`}>Details</a>
    </div>
  )}

  {confirm && (
    <p class="notice">
      <Icon name="alert" size={17} />
      <span>
        {newlyFound
          ? 'We found this on an official list of rescue partners, but nothing about it has been checked yet. Confirm before relying on it.'
          : org.status !== 'active' && org.status_note
          ? org.status_note
          : org.confidence === 'Low'
            ? 'Listed from a directory or social channel. Confirm this contact is still active before relying on it.'
            : age === null
              ? 'Not yet independently verified. Confirm this contact is still active before relying on it.'
              : `Last verified ${age} days ago. Confirm this contact is still active before relying on it.`}
      </span>
    </p>
  )}
</li>

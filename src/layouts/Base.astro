---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  /** Page path, used to mark the current nav item. */
  path?: string;
}

const { title, description, path = Astro.url.pathname } = Astro.props;
const fullTitle = title === 'NYC Animal Rescue' ? title : `${title} — NYC Animal Rescue`;

const nav = [
  { href: '/directory', label: 'Find help' },
  { href: '/ask', label: 'Ask' },
  { href: '/guides', label: 'Guides' },
  { href: '/about', label: 'About' },
];

const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!--
      The body font, fetched in parallel with the stylesheet rather than after
      it. `font-display: swap` means text is readable either way; this just
      shortens how long it is readable in the fallback.
    -->
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Set before first paint so no-JS styling never flashes. -->
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="site-title" href="/">
          <Logo size={34} class="site-title__mark" />
          <span class="site-title__text">
            NYC Animal Rescue
            <span class="site-title__sub">Free directory · All five boroughs</span>
          </span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="site-footer__grid">
          <div>
            <div class="site-footer__brand">
              <Logo size={30} />
              <strong>NYC Animal Rescue</strong>
            </div>
            <p style="margin:0;max-width:34ch">
              A free, community-maintained directory of animal help in New York City.
              No ads, no tracking, no accounts.
            </p>
          </div>

          <div>
            <h2>Find help</h2>
            <ul>
              <li><a href="/directory">Every resource</a></li>
              <li><a href="/directory?need=emergency-vet">24-hour emergency vets</a></li>
              <li><a href="/ask">Ask the assistant</a></li>
              <li><a href="/guides">Guides</a></li>
            </ul>
          </div>

          <div>
            <h2>This directory</h2>
            <ul>
              <li><a href="/about">How it is maintained</a></li>
              <li><a href="/status">Directory status</a></li>
              <li><a href="/about#confidence">What confidence means</a></li>
              <li><a href="/about#report">Report a problem</a></li>
            </ul>
          </div>
        </div>

        <p class="site-footer__note">
          Contact details go stale — <strong>confirm a number is still live before you rely on it
          in an emergency.</strong>
        </p>
      </div>
    </footer>
  </body>
</html>

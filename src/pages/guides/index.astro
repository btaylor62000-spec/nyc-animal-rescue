---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { GUIDES_GROUPED } from '../../data/guides.ts';

/*
 * An icon per guide, chosen by slug. Anything unmatched falls back to the
 * compass rather than throwing -- the importer can add a guide without this
 * page needing to know about it first.
 */
const ICONS: Record<string, 'bird' | 'cat' | 'home' | 'compass' | 'stethoscope' | 'leaf' | 'alert' | 'shield' | 'heart'> = {
  'animal-emergency': 'alert',
  'exotic-pet-emergency': 'alert',
  'found-an-injured-bird': 'bird',
  'found-wildlife': 'leaf',
  'starting-tnr': 'cat',
  'keeping-your-cat': 'cat',
  'cats-with-special-needs': 'cat',
  'lost-and-found-cat': 'compass',
  'lost-and-found-dog': 'compass',
  'lost-and-found-exotic': 'compass',
  'keeping-your-dog': 'home',
  'dog-behavior-and-legal': 'shield',
  'breed-specific-dog-rescue': 'home',
  'rehoming-an-exotic-pet': 'home',
  'exotic-boarding-and-planning': 'home',
  'exotic-pet-legality': 'shield',
  'help-paying-for-care': 'stethoscope',
  'low-cost-clinics-and-trap-banks': 'stethoscope',
  'low-cost-dog-care': 'stethoscope',
  'pets-in-a-disaster': 'alert',
  'report-animal-abuse': 'shield',
  'leaving-abuse-with-your-pet': 'shield',
  'save-an-at-risk-animal': 'heart',
  'keep-your-pet-if-you-lose-your-home': 'home',
};
---

<Base
  title="Guides"
  description="Plain-language guides for the situations people actually arrive in: injured birds, found kittens, lost pets, rehoming, and exotic pet emergencies."
>
  <div class="wrap">
    <h1>Guides</h1>
    <p class="lede">
      A guide tells you <strong>what to do</strong>, step by step, for one situation: how to pick up
      an injured bird, what to try before giving up a pet, how to report cruelty. Each one ends with
      the places to contact, taken from the directory.
    </p>
    <p class="notice">
      <Icon name="search" size={17} />
      <span>
        Already know what you need and just want a phone number? <a href="/directory">Find help</a> lists
        every rescue, clinic and hotline, and can show what is open now and nearest to you.
      </span>
    </p>

    {GUIDES_GROUPED.map((group) => (
      <section class="section" style="padding-top:1.25rem">
        <h2 style="font-size:1.15rem">{group.title}</h2>
        {group.places && (
          <p class="muted" style="margin:-.3rem 0 .6rem">
            Just need a number? <a href={group.places.href}>{group.places.label}</a>
          </p>
        )}
        <ul class="tiles">
          {group.guides.map((g) => (
            <li>
              <a class="tile" href={`/guides/${g.slug}`}>
                <span class="tile__icon"><Icon name={ICONS[g.slug] ?? 'compass'} size={20} /></span>
                <strong>{g.title}</strong>
                <span>{g.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

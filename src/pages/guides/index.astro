---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { GUIDE_GROUPS, LINES_BY_TIER } from '../../data/guides.ts';

/** "Just need a number?": each situation's own slice of the directory. */
const places = GUIDE_GROUPS.flatMap((g) => (g.places ? [g.places] : []));
---

<Base
  title="Guides"
  description="Plain-language guides for the situations people actually arrive in: injured birds, found kittens, lost pets, rehoming, and exotic pet emergencies."
>
  <div class="wrap">
    <h1>Guides</h1>
    <p class="lede">
      A guide tells you <strong>what to do</strong>, step by step, for one situation: how to pick up
      an injured bird, what to try before giving up a pet, how to report cruelty. Each one ends with
      the places to contact, taken from the directory.
    </p>
    <p class="notice">
      <Icon name="search" size={17} />
      <span>
        Already know what you need and just want a phone number? <a href="/directory">Find help</a> lists
        every rescue, clinic and hotline, and can show what is open now and nearest to you.
      </span>
    </p>

    <ul class="shortcuts">
      {places.map((p) => (
        <li><a class="btn" href={p.href}><Icon name="phone" size={17} />{p.label}</a></li>
      ))}
    </ul>

    <!-- The same numbered lines as the home page, here with what each guide covers. -->
    {LINES_BY_TIER.map((tier) => (
      <section class="section tier" style="margin-top:2rem" aria-labelledby={`tier-${tier.key}`}>
        <h2 class="tier__title" id={`tier-${tier.key}`}>{tier.title}</h2>
        <ul class="lines">
          {tier.lines.map((line) => (
            <li>
              <a href={`/guides/${line.guide.slug}`}>
                <span class={`bullet bullet--${line.tier}`} aria-hidden="true">{line.number}</span>
                <span class="lines__name">
                  {line.guide.title}
                  <span class="lines__summary">{line.guide.summary}</span>
                </span>
                <Icon name="arrow" size={20} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

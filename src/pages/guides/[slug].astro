---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { GUIDES, GUIDES_BY_SLUG } from '../../data/guides.ts';
import { renderMarkdown } from '../../data/markdown.ts';
import { BOROUGH_LABELS, LISTED_ORGS, ORGS } from '../../data/orgs.ts';
import { annotateMentions, buildMatchers } from '../../data/guide-mentions.ts';
import { assertGuideNamesOnlyListed } from '../../data/guide-integrity.ts';
import { GUIDE_LISTINGS, directoryHref, listingsFor } from '../../data/guide-listings.ts';
import { telHref } from '../../data/tel.ts';

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params;
const guide = GUIDES_BY_SLUG.get(slug!)!;
// Stops the build, so nothing is published, if this guide still sends
// people to a group the directory no longer lists (guide-integrity.ts).
assertGuideNamesOnlyListed(guide, ORGS);

// The guide's own <h1> comes from the Markdown, so the body is rendered as-is
// and the page heading is not duplicated above it.
// Every listed organization the guide names links to its listing, and each
// section ends with those organizations' current contacts (guide-mentions.ts).
const { html } = annotateMentions(renderMarkdown(guide.body), LISTED_ORGS, buildMatchers(LISTED_ORGS, guide.slug));

/** Guides where the first thing to know is that this may be an emergency. */
const URGENT = new Set(['animal-emergency', 'found-an-injured-bird', 'found-wildlife', 'exotic-pet-emergency']);
const isUrgent = URGENT.has(guide.slug);
const blocks = (GUIDE_LISTINGS[guide.slug] ?? []).map((b) => ({ ...b, orgs: listingsFor(b), href: directoryHref(b) }));
// Where "places to contact" goes: the guide's own directory filter if it has one.
const findHref = blocks.find((b) => b.href)?.href ?? '/directory';
const where = (o: (typeof blocks)[number]['orgs'][number]) =>
  o.outside_nyc ? 'Outside NYC, serves New Yorkers' : o.citywide ? 'Citywide' : o.boroughs.map((b) => BOROUGH_LABELS[b]).join(', ');
---

<Base title={guide.title} description={guide.summary}>
  <div class="wrap">
    <p class="muted" style="margin:1rem 0 0"><a href="/guides">&larr; All guides</a></p>

    {isUrgent && (
      <p class="notice notice--urgent" style="margin-top:1rem">
        <span aria-hidden="true">&#9888;</span>
        <span>
          If the animal is bleeding, struggling to breathe, collapsed, or has been caught by another animal,
          it needs care now. <a href="/directory?need=emergency-vet">24-hour emergency vets</a>.
        </span>
      </p>
    )}

    <p class="muted guide-lead">
      <strong>This is a guide:</strong> what to do, step by step. Organizations it names link to their
      listing, and each section ends with their current contacts. Looking only for a place to call?
      <a href={findHref}>Find help</a>.
    </p>

    <article class="guide-body" set:html={html} />

    {blocks.length > 0 && (
      <section class="guide-listings" aria-labelledby="guide-listings-heading">
        <h2 id="guide-listings-heading">Every listing for this in the directory</h2>
        <p class="muted">
          Built from the directory's own entries, so the numbers here are the ones kept current there.
          Tap a name for hours, address and how recently it was checked.
        </p>
        {blocks.map((b) => {
          const items = (
            <ul>
              {b.orgs.map((o) => (
                <li>
                  <a href={`/org/${o.id}`}>{o.name}</a>
                  <span class="muted"> · {where(o) || 'Area not recorded'}</span>
                  {o.phones[0] && <> · <a href={telHref(o.phones[0].value)}>{o.phones[0].display}</a></>}
                  {o.status !== 'active' && <> <span class="tag tag--strong">Confirm it is still running</span></>}
                </li>
              ))}
            </ul>
          );
          return (
            <div class="guide-listings__block">
              <h3>{b.heading} <span class="muted">({b.orgs.length})</span></h3>
              {b.orgs.length > 15 ? (
                <details>
                  <summary>Show all {b.orgs.length}</summary>
                  {items}
                </details>
              ) : items}
              {b.href && <p><a href={b.href}>See these in the directory, nearest to you first &rarr;</a></p>}
            </div>
          );
        })}
      </section>
    )}
    {guide.byline && (
      <p class="muted" style="margin-top:1.5rem;font-size:.95rem">Written by {guide.byline}.</p>
    )}

    <p class="notice" style="margin-top:2rem">
      <Icon name="alert" size={17} />
      <span>
        <strong>Wrong number, or something missing?</strong> Every organization named here has its own entry
        with a <strong>Report a problem</strong> button; <a href="/directory">find it in the directory</a>.
        Know a place that should be here? <a href="/contribute">Add a resource</a>. Changes go live in minutes.
      </span>
    </p>

    <hr style="margin:2.5rem 0 1rem;border:0;border-top:1px solid var(--border)" />
    <p class="muted" style="font-size:.9rem">
      This guide is compiled from the project's research files. Contact details inside it can go
      stale — check the <a href="/directory">directory</a> for the current listing, and confirm a
      number is live before you rely on it.
    </p>
  </div>
</Base>

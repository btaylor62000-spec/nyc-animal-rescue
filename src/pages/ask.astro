---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import Icon from '../components/Icon.astro';
import EmergencySigns from '../components/EmergencySigns.astro';
import { TURNSTILE_SITE_KEY } from '../data/site.ts';
import { LINES_BY_TIER } from '../data/guides.ts';

/**
 * The assistant lives on its own page so the home page stays fast and the
 * emergency route stays the first thing anyone sees.
 *
 * The Turnstile site key is public by design. When it is not configured the
 * page still works -- the endpoint skips verification too -- so the assistant
 * can be developed and tested before any credentials exist.
 */
const turnstileSiteKey = TURNSTILE_SITE_KEY;

/*
 * Starting points: the home page's 26 numbered guide lines, grouped by tier,
 * so the assistant offers the same map of help as the rest of the site
 * (owner, 2026-11-16). Tapping one asks it in those words; a test checks the
 * assistant answers each from its own guide.
 */
const examples = LINES_BY_TIER.map((t) => ({ key: t.key, title: t.title, lines: t.lines.map((l) => ({ number: l.number, label: l.label })) }));
---

<Base
  title="Ask for help"
  description="Describe what is happening and get pointed to the right animal rescue, clinic or rehabilitator in New York City."
>
  <div class="wrap">
    <h1>Ask for help</h1>
    <p class="lede">
      Describe what is happening in your own words. You will get the organizations that fit,
      with their real phone numbers.
    </p>

    <div class="notice notice--urgent">
      <Icon name="alert" size={17} />
      <div>
        <EmergencySigns compact />
        <p><strong>Don’t wait for an answer here.</strong></p>
      </div>
    </div>

    <div class="chat">
      <div id="chat-log" class="chat__log" role="log" aria-live="polite" aria-label="Conversation"></div>

      <p id="chat-status" class="chat__status" role="status"></p>

      <div id="chat-degraded" class="chat__degraded" hidden>
        <h3>The assistant is resting</h3>
        <p>
          It runs on a free daily allowance, and that is used up for today — or it could not be
          reached. The directory is unaffected, and search will get you there.
        </p>
        <a id="chat-degraded-search" class="btn btn--primary" href="/directory">Search the directory instead</a>
      </div>

      <div>
        <p class="muted" style="font-size:.9rem;margin-bottom:.45rem">Start from one of these, or describe it in your own words below:</p>
        <div id="chat-examples" class="chat__examples-groups">
          {examples.map((t) => (
            <details class={`chat__tier need-picker__group--${t.key}`} open={t.key === 'now'}>
              <summary class="need-picker__tier">{t.title}</summary>
              <ul class="chat__examples">
                {t.lines.map((l) => <li><button type="button" data-q={l.label}><span class="need-picker__num">{l.number}</span>{l.label}</button></li>)}
              </ul>
            </details>
          ))}
        </div>
      </div>

      <form id="chat-form" class="chat__form" data-turnstile-site-key={turnstileSiteKey}>
        <label class="visually-hidden" for="chat-input">What is happening?</label>
        <textarea
          id="chat-input"
          name="message"
          rows="2"
          maxlength="600"
          placeholder="e.g. I found a bird on the pavement in Astoria and it can't fly"
          autocomplete="off"
        ></textarea>
        <button id="chat-send" class="btn btn--primary" type="submit">
          <Icon name="arrow" size={17} />
          Ask
        </button>
      </form>
      <p class="chat__location">
        <label>
          <input id="chat-use-location" type="checkbox" />
          Use my location to put the nearest places first
        </label>
        <span id="chat-location-note" class="muted"></span>
      </p>

      <!--
        The bot check. Hidden until it is actually needed, then shown: a
        Managed challenge can ask the reader to click something, and a
        container with no layout gives them nothing to click.
      -->
      <div id="turnstile-wrap" class="chat__turnstile" hidden>
        <p class="chat__turnstile-label">One moment — just checking you are a person.</p>
        <div id="turnstile-host"></div>
      </div>

      <p class="chat__fineprint">
        <Icon name="shield" size={16} />
        <span>
          The assistant only knows what is in this directory. It will say so when it does not know,
          rather than guess. Nothing you type is stored or logged.
        </span>
      </p>
    </div>

    <noscript>
      <p class="notice">
        <Icon name="alert" size={17} />
        <span>The assistant needs JavaScript. Search the directory instead:</span>
      </p>
      <SearchBox label="Search every resource" />
    </noscript>
  </div>
</Base>

{turnstileSiteKey && (
  <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>
)}

<script>
  import '../client/chat.ts';
</script>

---
import Base from '../layouts/Base.astro';
import FilterPanel from '../components/FilterPanel.astro';
import OrgCard from '../components/OrgCard.astro';
import SearchBox from '../components/SearchBox.astro';
import { CONFIDENCE_ORDER, DATA_VERSION, LISTED_ORGS } from '../data/orgs.ts';
import { GUIDES } from '../data/guides.ts';

/**
 * Every record is rendered server-side. That keeps the page usable without
 * JavaScript, removes any loading state, and lets filtering be a DOM pass
 * rather than a re-render.
 *
 * Default order matches the sort the client applies with no query: firmest
 * evidence first, then most recently verified.
 */
const orgs = [...LISTED_ORGS].sort((a, b) => {
  const c = CONFIDENCE_ORDER[a.confidence] - CONFIDENCE_ORDER[b.confidence];
  if (c !== 0) return c;
  const av = a.last_verified ?? '';
  const bv = b.last_verified ?? '';
  if (av !== bv) return bv.localeCompare(av);
  return a.name.localeCompare(b.name);
});
import Icon from '../components/Icon.astro';
// Topic phrases for every guide, so a search can point at the steps as well
// as the organizations (src/data/guide-match.ts).
const guideTopics = JSON.stringify(GUIDES.map(({ slug, title, summary, topics }) => ({ slug, title, summary, topics })));
---

<Base
  title="Find help"
  description="Search and filter every animal rescue, clinic, hotline and rehabilitator in New York City."
>
  <div class="wrap">
    <h1>Find help</h1>
    <p class="muted" style="margin:.25rem 0 .75rem">
      Kept up to date by the people who use it. If a number is wrong or a place has closed, use <strong>Report a problem</strong> on its listing.
      Missing something? <a href="/contribute">Add a resource</a>.
    </p>
    <p class="lede">
      Every rescue, clinic, hotline and rehabilitator we have, filterable by borough,
      animal and what you need.
    </p>
    <SearchBox label="Search every resource" action="/directory" />

    <button class="btn filters-toggle" id="filters-toggle" type="button" aria-expanded="false" aria-controls="filters" data-requires-js>
      Show filters
    </button>

    <div class="layout">
      <aside aria-labelledby="filters-heading">
        <h2 id="filters-heading" class="visually-hidden">Filters</h2>
        <FilterPanel />
      </aside>

      <section aria-labelledby="results-heading">
        <h2 id="results-heading" class="visually-hidden">Results</h2>
        <div class="results-bar">
          <p id="results-summary" role="status" class="results-bar__count">
            Showing all {orgs.length} resources
          </p>
          <p class="results-bar__order">
            <span id="results-order" class="filters__count">Strongest evidence first</span>
            <button id="near-me" class="btn btn--ghost btn--small" type="button" hidden>Nearest to me</button>
            <span class="near-zip">
              <label for="near-zip">or nearest to zip</label>
              <input id="near-zip" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" placeholder="11215" autocomplete="postal-code" />
            </span>
          </p>
          <p id="near-me-note" class="filters__count" hidden></p>
        </div>

        <div id="guide-hints" class="guide-hints" hidden></div>
        <script type="application/json" id="guide-topics" set:html={guideTopics} />

        <ul class="results" id="results" data-index-url={`/search-index.json?v=${DATA_VERSION}`}>
          {orgs.map((org) => <OrgCard org={org} />)}
        </ul>

        <p id="no-results" hidden class="notice">
          <Icon name="info" size={17} />
          <span>
            Nothing matches those filters. Try removing one, or
            <a href="/directory">start over</a>. If you cannot find what you need,
            <a href="/org/mayors-alliance-for-nycs-animals">the Mayor’s Alliance directory</a>
            lists smaller and newer groups.
          </span>
        </p>
      </section>
    </div>
  </div>
</Base>

<script>
  import '../client/directory.ts';
</script>

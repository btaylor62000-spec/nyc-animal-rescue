---
/*
 * Emergency page, option B: one question first. Two big buttons, "It's hurt
 * or very ill" and "It swallowed something". Tapping one shows only what that
 * case needs; poison puts the poison line first, because poison control
 * tells the hospital the treatment before you arrive. A preview for the
 * reviewer (second round, 2026-11-06); not linked and not indexed.
 */
import Base from '../../layouts/Base.astro';
import EmergencyFinder from '../../components/EmergencyFinder.astro';
import { POISON, TOXIC } from '../../data/emergency-page.ts';
---
<Base title="Emergency (option B)" noindex>
  <div class="wrap em" data-mode="">
    <p class="em__tag">Option B · one question first</p>
    <h1>What happened?</h1>
    <div class="em__choose">
      <button type="button" data-pick="hurt"><span aria-hidden="true">🩸</span>It's hurt or very ill<small>Hit by a car, bleeding, not breathing, seizure, collapsed, cannot pass urine</small></button>
      <button type="button" data-pick="poison"><span aria-hidden="true">☠️</span>It swallowed or touched something toxic<small>A plant, a pill, a chemical, food</small></button>
    </div>

    <section class="em__step em__step--poison">
      <p class="em__n">1 · Call Poison Control now</p>
      <a class="em__poison-call" href={POISON[0].tel}>Call {POISON[0].phone}</a>
      <p>24 hours, vet toxicologists. Do <strong>not</strong> make it vomit unless they tell you to. Busy? {POISON[1].name}, <a href={POISON[1].tel}>{POISON[1].phone}</a>.</p>
      <p class="em__small">{TOXIC}</p>
      <p class="em__n">2 · Then go to a hospital open now</p>
    </section>

    <section class="em__step em__step--finder">
      <p class="em__n em__n--hurt">Go to a 24-hour hospital now. Ring on the way.</p>
      <EmergencyFinder count={3} />
      <p class="em__small">Worried about the cost? Go anyway, and ask about payment plans. <a href="/guides/help-paying-for-care">Help paying</a></p>
    </section>

    <p class="em__small">A wild animal? <a href="/guides/found-an-injured-bird">Bird</a> · <a href="/guides/found-wildlife">Any other wild animal</a></p>
  </div>
</Base>
<script>
  const page = document.querySelector<HTMLElement>('.em')!;
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-pick]')) {
    b.addEventListener('click', () => {
      page.dataset.mode = b.dataset.pick!;
      for (const o of document.querySelectorAll('[data-pick]')) o.setAttribute('aria-pressed', String(o === b));
      page.querySelector(b.dataset.pick === 'poison' ? '.em__step--poison' : '.em__step--finder')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
</script>
<style>
  .em { max-width: 34rem; padding-bottom: 3rem; }
  .em__tag { margin: 1rem 0 0; font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; color: var(--text-muted); }
  .em h1 { margin: .3rem 0 .8rem; }
  .em__choose { display: grid; gap: .7rem; }
  .em__choose button { font: inherit; text-align: left; display: grid; grid-template-columns: 2.6rem 1fr; column-gap: .6rem; align-items: center; padding: 1rem; border-radius: 14px; border: 2px solid transparent; color: #fff; font-size: 1.2rem; font-weight: 750; cursor: pointer; }
  .em__choose button span { grid-row: span 2; font-size: 2rem; }
  .em__choose button small { font-size: .92rem; font-weight: 500; opacity: .95; }
  .em__choose [data-pick='hurt'] { background: var(--urgent); color: var(--urgent-btn-text); }
  .em__choose [data-pick='poison'] { background: #8a4b00; }
  .em__choose button[aria-pressed='true'] { outline: 4px solid var(--text); outline-offset: 2px; }
  .em__step { display: none; margin-top: 1.3rem; }
  .em[data-mode='poison'] .em__step--poison, .em[data-mode='poison'] .em__step--finder, .em[data-mode='hurt'] .em__step--finder { display: block; }
  .em[data-mode='poison'] .em__n--hurt { display: none; }
  .em__n { font-weight: 750; font-size: 1.15rem; margin: 0 0 .6rem; }
  .em__step--poison .em__n:last-child { margin: 1.4rem 0 0; }
  .em__poison-call { display: block; text-align: center; background: #8a4b00; color: #fff !important; text-decoration: none; font-weight: 750; font-size: 1.15rem; padding: .9rem; border-radius: 10px; }
  .em__step p { margin: .55rem 0 0; }
  .em__small { color: var(--text-muted); font-size: .9rem; margin-top: .9rem; }
</style>

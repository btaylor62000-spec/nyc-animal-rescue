---
/*
 * Emergency page, option A: one screen. Say where you are, and the three
 * nearest hospitals open right now appear with a call button each. Poison
 * control sits underneath. A preview for the reviewer (second round,
 * 2026-11-06); not linked from the site and not indexed.
 */
import Base from '../../layouts/Base.astro';
import EmergencyFinder from '../../components/EmergencyFinder.astro';
import { POISON, TOXIC } from '../../data/emergency-page.ts';
---
<Base title="Emergency (option A)" noindex>
  <div class="wrap em">
    <p class="em__tag">Option A · one screen</p>
    <h1>Animal emergency</h1>
    <p class="em__lede">Hit by a car, bleeding, not breathing, a seizure, collapsed, cannot pass urine? <strong>Go to a 24-hour hospital now. Ring on the way.</strong></p>

    <EmergencyFinder count={3} />

    <div class="em__poison">
      <p class="em__poison-h">☠️ Swallowed or touched something toxic? Call Poison Control first</p>
      <a class="em__poison-call" href={POISON[0].tel}>Call {POISON[0].phone}</a>
      <p>ASPCA, 24 hours. Do <strong>not</strong> make it vomit unless they tell you to. Busy? {POISON[1].name}, <a href={POISON[1].tel}>{POISON[1].phone}</a>.</p>
      <p class="em__small">{TOXIC}</p>
    </div>

    <p class="em__small">Worried about the cost? Go anyway, and ask about payment plans. <a href="/guides/help-paying-for-care">Help paying</a></p>
    <p class="em__small">A wild animal? <a href="/guides/found-an-injured-bird">Bird</a> · <a href="/guides/found-wildlife">Any other wild animal</a></p>
  </div>
</Base>
<style>
  .em { max-width: 34rem; padding-bottom: 3rem; }
  .em__tag { margin: 1rem 0 0; font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; color: var(--text-muted); }
  .em h1 { margin: .3rem 0 .4rem; }
  .em__lede { font-size: 1.1rem; margin: 0 0 1.1rem; }
  .em__poison { margin-top: 1.6rem; border: 2px solid var(--warn-border); background: var(--warn-bg); border-radius: 14px; padding: .9rem; }
  .em__poison-h { font-weight: 750; font-size: 1.1rem; margin: 0 0 .5rem; }
  .em__poison-call { display: block; text-align: center; background: #8a4b00; color: #fff !important; text-decoration: none; font-weight: 750; font-size: 1.1rem; padding: .85rem; border-radius: 10px; }
  .em__poison p { margin: .55rem 0 0; }
  .em__small { color: var(--text-muted); font-size: .9rem; margin-top: .9rem; }
</style>

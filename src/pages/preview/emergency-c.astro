---
/*
 * Emergency page, option C: two call buttons that never leave the bottom of
 * the screen -- the nearest hospital open now, and poison control -- so the
 * reader can scroll, read, panic, and still ring with one thumb. Choosing
 * where you are fills in the first button. A preview for the reviewer
 * (second round, 2026-11-06); not linked from the site and not indexed.
 */
import Base from '../../layouts/Base.astro';
import EmergencyFinder from '../../components/EmergencyFinder.astro';
import { POISON, TOXIC } from '../../data/emergency-page.ts';
---
<Base title="Emergency (option C)" noindex>
  <div class="wrap em">
    <p class="em__tag">Option C · call buttons always on screen</p>
    <h1>Animal emergency</h1>
    <ul class="em__signs" aria-label="Go now if it is">
      <li>🚗 Hit by a car</li><li>🩸 Bleeding</li><li>😮‍💨 Not breathing</li>
      <li>⚡ Seizure</li><li>⬇️ Collapsed</li><li>🚫 Cannot pass urine</li><li>☠️ Ate something toxic</li>
    </ul>
    <p class="em__lede"><strong>Any of these: go to a 24-hour hospital now. Ring on the way.</strong></p>

    <EmergencyFinder count={3} heading="Where are you? Pick one" />

    <div class="em__poison">
      <p><strong>☠️ Toxic?</strong> Ring Poison Control first, 24 hours: <a href={POISON[0].tel}>{POISON[0].phone}</a>. Do <strong>not</strong> make it vomit unless they tell you to. Busy? {POISON[1].name}, <a href={POISON[1].tel}>{POISON[1].phone}</a>.</p>
      <p class="em__small">{TOXIC}</p>
    </div>
    <p class="em__small">Worried about the cost? Go anyway, and ask about payment plans. <a href="/guides/help-paying-for-care">Help paying</a></p>
    <p class="em__small">A wild animal? <a href="/guides/found-an-injured-bird">Bird</a> · <a href="/guides/found-wildlife">Any other wild animal</a></p>
  </div>
  <nav class="em__bar" aria-label="Call now">
    <a class="em__bar-vet is-waiting" href="#where" data-em-first>Call nearest open vet<small>Pick where you are first</small></a>
    <a class="em__bar-poison" href={POISON[0].tel}>Poison Control<small>{POISON[0].phone}</small></a>
  </nav>
</Base>
<style>
  .em { max-width: 34rem; padding-bottom: 7rem; }
  .em__tag { margin: 1rem 0 0; font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; color: var(--text-muted); }
  .em h1 { margin: .3rem 0 .6rem; }
  .em__signs { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .em__signs li { border: 1px solid var(--border); background: var(--surface); border-radius: 999px; padding: .35rem .7rem; font-weight: 600; }
  .em__lede { font-size: 1.1rem; margin: .8rem 0 1.1rem; }
  .em__poison { margin-top: 1.4rem; border: 2px solid var(--warn-border); background: var(--warn-bg); border-radius: 14px; padding: .8rem .9rem; }
  .em__poison p { margin: 0; }
  .em__poison .em__small { margin-top: .5rem; }
  .em__small { color: var(--text-muted); font-size: .9rem; margin-top: .9rem; }
  .em__bar { position: fixed; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 3fr 2fr; gap: .4rem; padding: .5rem .5rem calc(.5rem + env(safe-area-inset-bottom)); background: var(--bg); border-top: 1px solid var(--border); z-index: 20; }
  .em__bar a { display: flex; flex-direction: column; justify-content: center; text-align: center; color: #fff !important; text-decoration: none; font-weight: 750; font-size: 1.05rem; padding: .6rem .4rem; border-radius: 12px; min-height: 56px; line-height: 1.2; }
  .em__bar small { font-weight: 500; font-size: .82rem; opacity: .95; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .em__bar-vet { background: var(--urgent); color: var(--urgent-btn-text) !important; }
  .em__bar-vet.is-waiting { filter: saturate(.6); }
  .em__bar-poison { background: #8a4b00; }
</style>

---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import Icon from '../components/Icon.astro';
import { LISTED_ORGS as ORGS } from '../data/orgs.ts';
import { GUIDE_GROUPS, LINES_BY_TIER } from '../data/guides.ts';

/**
 * The home page answers one question: what happened, and where do I tap?
 *
 * It is built like a sign rather than a brochure (2026-11-13). The emergency
 * band is the first thing under the header, at every width: measured on a
 * phone, the old page put it 830px down, below the whole first screen, behind
 * a headline and four statistics. After it, every guide is a numbered line,
 * most urgent first, so the list reads top to bottom in the order someone in
 * trouble needs it. There is one list, not a short one and a long one; a
 * reviewer found two lists confusing in an emergency (2026-11-05).
 */
const orgCount = ORGS.length;

/** "Just need a number?": each situation's own slice of the directory. */
const places = GUIDE_GROUPS.flatMap((g) => (g.places ? [g.places] : []));
---

<Base
  title="NYC Animal Rescue"
  description="Find the right animal rescue, clinic or rehabilitator in New York City — for cats, dogs, birds, wildlife and exotic pets."
>
  <h1 class="visually-hidden">Find help for an animal in New York City</h1>

  <section class="eband" aria-labelledby="emergency-heading">
    <a class="eband__go" href="/directory?need=emergency-vet">
      <span class="wrap eband__row">
        <span class="bullet bullet--e bullet--xl" aria-hidden="true">E</span>
        <span class="eband__text">
          <strong id="emergency-heading">Emergency</strong>
          <span>24-hour vets, nearest first</span>
        </span>
        <Icon name="arrow" size={30} />
      </span>
    </a>
    <div class="wrap eband__more">
      <p>
        If you think an animal is hurt, very ill or in danger — for example bleeding, struggling to
        breathe, collapsed, hit by a car, has swallowed something toxic, <strong>has been caught by another
        animal</strong>, or anything else that worries you — it needs a vet or a wildlife rehabilitator now,
        not a rescue group. Not sure? Ring a 24-hour vet and ask. Call ahead so they are ready for you.
      </p>
      <a class="btn eband__btn" href="/guides/animal-emergency">What to do first</a>
    </div>
  </section>

  <div class="wrap">
    <section class="section section--first" aria-labelledby="what-heading">
      <h2 id="what-heading">What happened?</h2>
      <div class="tiers">
        {LINES_BY_TIER.map((tier) => (
          <section class="tier" aria-labelledby={`tier-${tier.key}`}>
            <h3 class="tier__title" id={`tier-${tier.key}`}>{tier.title}</h3>
            <ul class="lines">
              {tier.lines.map((line) => (
                <li>
                  <a href={`/guides/${line.guide.slug}`}>
                    <span class={`bullet bullet--${line.tier}`} aria-hidden="true">{line.number}</span>
                    <span class="lines__name">{line.label}</span>
                    <Icon name="arrow" size={20} />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="numbers-heading">
      <h2 id="numbers-heading">Just need a phone number?</h2>
      <ul class="shortcuts">
        {places.map((p) => (
          <li><a class="btn" href={p.href}><Icon name="phone" size={17} />{p.label}</a></li>
        ))}
      </ul>
    </section>

    <section class="section" aria-labelledby="search-heading">
      <h2 id="search-heading">Search all {orgCount} places</h2>
      <SearchBox label={`Search all ${orgCount} places`} />
      <p class="muted" style="margin-top:-.2rem">
        Not sure what to search for? <a href="/ask">Describe what is happening</a> and get pointed
        to the right place.
      </p>
    </section>

    <section class="section">
      <div class="panel">
        <span class="eyebrow"><Icon name="heart" size={14} /> Kept by the community</span>
        <h2>Know a rescue that is missing? Spot a wrong number?</h2>
        <p>
          This directory is kept up to date by the people who use it. Anyone can add a rescue,
          clinic or hotline, and every entry has a <strong>Report a problem</strong> button. What you
          send is checked against the organization's own website and goes live in a few minutes,
          marked as added or fixed by a visitor.
        </p>
        <div class="hero__actions" style="margin-bottom:0">
          <a class="btn btn--primary" href="/contribute">
            <Icon name="plus" size={17} />
            Add a resource
          </a>
          <a class="btn" href="/directory">Find an entry to fix</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="panel">
        <span class="eyebrow"><Icon name="shield" size={14} /> Before you call</span>
        <h2>Every entry says how well we know it</h2>
        <p>
          Rescue contact details go stale quickly — small groups fold, numbers change, volunteers move on.
          Every entry here shows when it was last checked and how firmly it is verified, and entries we are
          less sure about say so plainly. <strong>Confirm a number is live before you rely on it.</strong>
        </p>
        <p style="margin-bottom:0">
          <a href="/about">How this directory is maintained</a>
        </p>
      </div>
    </section>
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import Icon from '../components/Icon.astro';
import Skyline from '../components/Skyline.astro';
import { LISTED_ORGS as ORGS } from '../data/orgs.ts';
import { GUIDES_GROUPED } from '../data/guides.ts';

/**
 * The home page answers one question: what happened, and where do I tap?
 * The emergency route comes first, because someone holding an injured animal
 * should not have to read. After it, every guide by situation, each group
 * with a link straight to the places to contact. There used to be a second,
 * shorter set of tiles above the guides; a reviewer found the two lists
 * confusing in an emergency (2026-11-05), so there is one.
 */
const orgCount = ORGS.length;
const emergencyCount = ORGS.filter((o) => o.needs.includes('emergency-vet')).length;
const verifiedCount = ORGS.filter((o) => o.confidence === 'High').length;
---

<Base
  title="NYC Animal Rescue"
  description="Find the right animal rescue, clinic or rehabilitator in New York City — for cats, dogs, birds, wildlife and exotic pets."
>
  <section class="hero">
    <Skyline class="hero__banner" />
    <div class="wrap">
      <h1>Find help for an animal in New York City</h1>
      <p class="lede">
        {orgCount} rescues, clinics, hotlines and rehabilitators across the five boroughs.
        Free to use, kept current by New Yorkers like you, and honest about what it does not know.
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="/directory">
          <Icon name="search" size={19} />
          Search every resource
        </a>
        <a class="btn btn--lg" href="/ask">
          <Icon name="message" size={19} />
          Describe what happened
        </a>
      </div>

      <dl class="stats">
        <div><dd>{orgCount}</dd><dt>Organizations listed</dt></div>
        <div><dd>{emergencyCount}</dd><dt>Emergency vets</dt></div>
        <div><dd>{verifiedCount}</dd><dt>Verified on their own site</dt></div>
        <div><dd>5</dd><dt>Boroughs covered</dt></div>
      </dl>
    </div>
  </section>

  <div class="wrap">
    <section class="emergency" aria-labelledby="emergency-heading">
      <h2 id="emergency-heading">
        <Icon name="alert" size={22} />
        Is this an emergency?
      </h2>
      <p>
        If an animal is bleeding, struggling to breathe, collapsed, seizing, has been hit by a car,
        has swallowed something toxic, or <strong>has been caught by another animal</strong> — it needs a
        vet or a wildlife rehabilitator now, not a rescue group. Call ahead so they are ready for you.
      </p>
      <div class="emergency__actions">
        <a class="btn btn--urgent" href="/directory?need=emergency-vet">24-hour emergency vets</a>
        <a class="btn" href="/guides/animal-emergency">What to do first</a>
        <a class="btn" href="/guides/found-an-injured-bird">A wild bird is hurt</a>
        <a class="btn" href="/guides/found-wildlife">Another wild animal is hurt</a>
        <a class="btn" href="/guides/report-animal-abuse">Someone is hurting an animal</a>
      </div>
    </section>

    <section class="section" aria-labelledby="what-heading">
      <span class="eyebrow">Start from what happened</span>
      <h2 id="what-heading">What happened?</h2>
      <p class="muted" style="margin-top:-.25rem">
        Each guide says what to do, step by step, and who to call. To go straight to phone numbers,
        use the link under each heading, or <a href="/directory">Find help</a>.
      </p>
      <div class="situations">
        {GUIDES_GROUPED.map((group) => (
          <div class="situation">
            <h3>{group.title}</h3>
            <ul>
              {group.guides.map((g) => (
                <li><a href={`/guides/${g.slug}`}>{g.title}</a></li>
              ))}
            </ul>
            {group.places && (
              <p class="situation__places">
                <Icon name="search" size={15} /> <a href={group.places.href}>{group.places.label}</a>
              </p>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <span class="eyebrow">Or search directly</span>
      <h2>Search every resource</h2>
      <SearchBox label="Search every resource" />
      <p class="muted" style="margin-top:-.2rem">
        Not sure what to search for? <a href="/ask">Describe what is happening</a> and get pointed
        to the right place.
      </p>
    </section>

    <section class="section">
      <div class="panel">
        <span class="eyebrow"><Icon name="heart" size={14} /> Kept by the community</span>
        <h2>Know a rescue that is missing? Spot a wrong number?</h2>
        <p>
          This directory is kept up to date by the people who use it. Anyone can add a rescue,
          clinic or hotline, and every entry has a <strong>Report a problem</strong> button. What you
          send is checked against the organization's own website and goes live in a few minutes,
          marked as added or fixed by a visitor.
        </p>
        <div class="hero__actions" style="margin-bottom:0">
          <a class="btn btn--primary" href="/contribute">
            <Icon name="plus" size={17} />
            Add a resource
          </a>
          <a class="btn" href="/directory">Find an entry to fix</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="panel">
        <span class="eyebrow"><Icon name="shield" size={14} /> Before you call</span>
        <h2>Every entry says how well we know it</h2>
        <p>
          Rescue contact details go stale quickly — small groups fold, numbers change, volunteers move on.
          Every entry here shows when it was last checked and how firmly it is verified, and entries we are
          less sure about say so plainly. <strong>Confirm a number is live before you rely on it.</strong>
        </p>
        <p style="margin-bottom:0">
          <a href="/about">How this directory is maintained</a>
        </p>
      </div>
    </section>
  </div>
</Base>

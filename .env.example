# Copy to .env for local development. All of it is optional: the site builds
# and runs with none of it set.

# owner/repo on GitHub, for the "report a problem" links.
# Without it the site says reporting is not connected yet, rather than
# pointing people at a link that 404s.
PUBLIC_GITHUB_REPO=your-github-username/nyc-animal-rescue

# Turnstile site key. Public by design — it appears in the page.
# The matching secret key is set in Cloudflare Pages, never here.
PUBLIC_TURNSTILE_SITE_KEY=

# For `npm run evals -- --live` only. A Cloudflare API token with
# "Workers AI" permission, and your account id from the dashboard sidebar.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

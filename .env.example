# Copy to .env for local development. All of it is optional.
#
# Note: the two public values — the GitHub repo slug and the Turnstile site
# key — live in src/data/site.ts, not here. They are rendered into the page
# anyway, and keeping them in the repository means one place to look. These
# variables override them, which is what a fork would use.
PUBLIC_GITHUB_REPO=
PUBLIC_TURNSTILE_SITE_KEY=

# For `npm run evals -- --live` only. A Cloudflare API token with
# "Workers AI" permission, and your account id from the dashboard sidebar.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

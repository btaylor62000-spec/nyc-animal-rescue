{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nycanimalrescue.org/schema/org.schema.json",
  "title": "Organization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "aka",
    "parent_org",
    "org_types",
    "animals",
    "needs",
    "boroughs",
    "citywide",
    "outside_nyc",
    "neighborhoods",
    "zips",
    "region_note",
    "phones",
    "emails",
    "website",
    "intake_urls",
    "social",
    "address",
    "hours",
    "notes",
    "type_raw",
    "confidence",
    "status",
    "status_note",
    "source_urls",
    "last_verified",
    "section",
    "source_files",
    "last_checked",
    "check_status",
    "consecutive_failures",
    "change_log",
    "privacy_hold",
    "community"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "aka": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parent_org": {
      "type": [
        "string",
        "null"
      ]
    },
    "org_types": {
      "type": "array",
      "items": {
        "enum": [
          "shelter-open-admission",
          "shelter-no-kill",
          "rescue-foster",
          "tnr-group",
          "solo-rescuer",
          "clinic",
          "emergency-vet",
          "exotic-vet",
          "wildlife-rehabber",
          "sanctuary",
          "referral-hub",
          "advocacy",
          "hotline",
          "government",
          "club-society",
          "directory",
          "support-program"
        ]
      }
    },
    "animals": {
      "type": "array",
      "items": {
        "enum": [
          "cat",
          "dog",
          "rabbit",
          "small-mammal",
          "bird-companion",
          "bird-wild",
          "pigeon",
          "reptile",
          "amphibian",
          "fish",
          "farm",
          "equine",
          "wildlife",
          "marine",
          "invertebrate"
        ]
      }
    },
    "needs": {
      "type": "array",
      "items": {
        "enum": [
          "emergency-vet",
          "poison-control",
          "wildlife-rehab",
          "adoption",
          "surrender",
          "foster",
          "tnr",
          "colony-care",
          "trap-bank",
          "spay-neuter",
          "low-cost-vet",
          "exotic-vet",
          "neonatal",
          "medical-special-needs",
          "senior",
          "retrovirus",
          "lost-found",
          "microchip",
          "behavior-training",
          "financial-aid",
          "food-assistance",
          "owner-support",
          "boarding",
          "sanctuary",
          "working-cat",
          "transport",
          "legal",
          "breed-specific",
          "education",
          "advocacy",
          "licensing",
          "pet-loss",
          "referral"
        ]
      }
    },
    "boroughs": {
      "type": "array",
      "items": {
        "enum": [
          "manhattan",
          "brooklyn",
          "queens",
          "bronx",
          "staten-island"
        ]
      },
      "uniqueItems": true
    },
    "citywide": {
      "type": "boolean"
    },
    "outside_nyc": {
      "type": "boolean"
    },
    "neighborhoods": {
      "type": [
        "string",
        "null"
      ]
    },
    "zips": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{5}$"
      },
      "uniqueItems": true
    },
    "region_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "phones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "display"
        ],
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^(\\d{10}|\\d{3})$"
          },
          "display": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "emails": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "string",
            "format": "email"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "website": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "intake_urls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "social": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "handle"
        ],
        "properties": {
          "platform": {
            "enum": [
              "instagram",
              "facebook",
              "x",
              "tiktok",
              "youtube",
              "linktree",
              "petfinder",
              "other"
            ]
          },
          "handle": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "address": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "borough": {
          "enum": [
            "manhattan",
            "brooklyn",
            "queens",
            "bronx",
            "staten-island"
          ]
        },
        "zip": {
          "type": "string",
          "pattern": "^\\d{5}$"
        }
      }
    },
    "hours": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "type_raw": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "status": {
      "enum": [
        "active",
        "verify",
        "hiatus",
        "relocated",
        "retired"
      ]
    },
    "status_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_verified": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "section": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "last_checked": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "check_status": {
      "enum": [
        "ok",
        "changed",
        "unreachable",
        "needs-review",
        "new-unverified",
        "unchecked"
      ]
    },
    "consecutive_failures": {
      "type": "integer",
      "minimum": 0
    },
    "change_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "field",
          "from",
          "to",
          "source"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "field": {
            "type": "string"
          },
          "from": {
            "type": [
              "string",
              "null"
            ]
          },
          "to": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_url": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "privacy_hold": {
      "type": "boolean"
    },
    "community": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "added_on",
        "corrected_on"
      ],
      "properties": {
        "added_on": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "corrected_on": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}
